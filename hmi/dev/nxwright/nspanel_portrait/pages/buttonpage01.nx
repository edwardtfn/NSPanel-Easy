on buttonpage01.load:
  // Redirect to home if API is not connected
  if(api==0)
  {
    page home_page_id
  }
  // Build page index dots based on active pages
  page_index.txt=""
  page_index.txt+="●"  // Current page (filled)
  if(is_buttonpage02>0)
  {
    page_index.txt+="○"
  }
  if(is_buttonpage03>0)
  {
    page_index.txt+="○"
  }
  if(is_buttonpage04>0)
  {
    page_index.txt+="○"
  }
  // Light mode only: set background images and foreground colors
  if(theme==1)
  {
    // Page background
    b[0].pic=pic_background_main
    // Page label
    page_label.pco=color_pco_main
    page_label.picc=pic_background_main
    // Page index dots
    page_index.pco=color_pco_navigation
    page_index.picc=pic_background_main
    // Back button
    button_back.pco=color_pco_navigation
    button_back.picc=pic_background_main
    button_back.picc2=pic_background_main
    // Button sub-components (pic, icon, text, bri slots: ids 11-42)
    for(sys0=11;sys0<=42;sys0++)
    {
      b[sys0].picc=pic_background_main
    }
  }
  button_back.font=button_back_font
  // Set up button slots from bitmask
  for(sys0=0;sys0<8;sys0++)
  {
    sys1=1<<sys0
    sys2=is_buttonpage01&sys1
    if(sys2==0)
    {
      // Slot not configured - hide all sub-components
      sys3=sys0+11  // pic
      vis b[sys3],0
      sys3=sys0+19  // text
      vis b[sys3],0
      sys3=sys0+27  // icon
      vis b[sys3],0
      sys3=sys0+35  // bri
      vis b[sys3],0
      sys3=sys0+43  // hotspot
      vis b[sys3],0
    }else
    {
      // Slot configured - set off state background picture
      sys3=sys0+11  // pic
      b[sys3].picc=pic_button_off
      sys3=sys0+19  // text
      b[sys3].picc=pic_button_off
      sys3=sys0+27  // icon
      b[sys3].picc=pic_button_off
      sys3=sys0+35  // bri
      b[sys3].picc=pic_button_off
    }
  }
  dim=brightness
  sendme

on swipe.down:
  swipestore.en=1 // Start swipestore timer

on swipe.up:
  if(api==0)
  {
    page home_page_id
  }
  swipestore.en=0
  // Touch has ended, x
  if(tch0==0)
  {
    swipec=swipex-tch2
    // From Left to Right
    if(swipec>swipedx)
    {
      page home_page_id
    }
    // Right to Left
    swipec2=0-swipedx
    if(swipec<swipec2)
    {
      if(is_buttonpage02>=1)
      {
        page buttonpage02
      }else if(is_buttonpage03>=1)
      {
        page buttonpage03
      }else if(is_buttonpage04>=1)
      {
        page buttonpage04
      }else
      {
        page home_page_id
      }
    }
  }
  // Touch has ended, y
  if(tch1==0)
  {
    swipec=swipey-tch3
    // From Up to Down
    if(swipec>100)
    {
      if(is_buttonpage04>=1)
      {
        page buttonpage04
      }else if(is_buttonpage03>=1)
      {
        page buttonpage03
      }else if(is_buttonpage02>=1)
      {
        page buttonpage02
      }else
      {
        page home_page_id
      }
    }
    // Down to Up
    swipec2=0-swipedy
    if(swipec<-100)
    {
      if(is_buttonpage02>=1)
      {
        if(is_buttonpage03>=1)
        {
          page buttonpage03
        }else if(is_buttonpage04>=1)
        {
          page buttonpage04
        }else
        {
          page home_page_id
        }
      }else if(is_buttonpage03>=1)
      {
        if(is_buttonpage04>=1)
        {
          page buttonpage04
        }else
        {
          page home_page_id
        }
      }else
      {
        page home_page_id
      }
    }
  }

on swipestore.timer:
  swipex=tch0
  swipey=tch1

on button_back.down:
  page home_page_id

on click_timer.timer:
  lastclick.txt=page_name.txt+",long_click,"+click_comp.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lastclick.txt,0
  printh 00
  printh FF FF FF
  click_timer.en=0

on button01.down:
  click_comp.txt="button01"
  click_timer.en=1

on button01.up:
  if(click_timer.en==1)
  {
    click_timer.en=0
    sys0=confirm.val&1
    if(sys0>0)
    {
      confirm.body.txt=button01text.txt
      confirm.page_id.val=dp
      confirm.page_name.txt=page_name.txt
      confirm.component.txt=click_comp.txt
      page confirm
    }else
    {
      lastclick.txt=page_name.txt+",short_click,"+click_comp.txt
      printh 92
      prints "localevent",0
      printh 00
      prints lastclick.txt,0
      printh 00
      printh FF FF FF
    }
  }

