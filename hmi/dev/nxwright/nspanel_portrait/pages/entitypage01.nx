on entitypage01.load:
  if(api==0)
  {
    page home_page_id
  }
  sys0=is_entitypage01+is_entitypage02+is_entitypage03+is_entitypage04
  if(sys0>1)
  {
    page_index.txt+="●"
    if(is_entitypage02==1)
    {
      page_index.txt+="○"
    }
    if(is_entitypage03==1)
    {
      page_index.txt+="○"
    }
    if(is_entitypage04==1)
    {
      page_index.txt+="○"
    }
  }else
  {
    vis page_index,0
  }
  // set background image and fg color to all components
  b[0].pic=pic_background_main
  for(sys0=3;sys0<=29;sys0++)
  {
    b[sys0].picc=pic_background_main
    b[sys0].pco=color_pco_main
  }
  button_back.font=button_back_font
  button_back.picc2=pic_background_main
  button_back.pco=color_pco_navigation
  page_index.pco=color_pco_navigation
  dim=brightness
  sendme

on swipe.down:
  swipestore.en=1 // Start swipestore timer

on swipe.up:
  if(api==0)
  {
    page home_page_id
  }
  swipestore.en=0
  // Touch has ended, x
  if(tch0==0)
  {
    swipec=swipex-tch2
    // From Left to Right
    if(swipec>swipedx)
    {
      page home_page_id
    }
    // Right to Left
    swipec2=0-swipedx
    if(swipec<swipec2)
    {
      if(is_entitypage02==1)
      {
        page entitypage02
      }else if(is_entitypage03==1)
      {
        page entitypage03
      }else if(is_entitypage04==1)
      {
        page entitypage04
      }else
      {
        page home_page_id
      }
    }
  }
  // Touch has ended, y
  if(tch1==0)
  {
    swipec=swipey-tch3
    // From Up to Down
    if(swipec>100)
    {
      if(is_entitypage04==1)
      {
        page entitypage04
      }else if(is_entitypage03==1)
      {
        page entitypage03
      }else if(is_entitypage02==1)
      {
        page entitypage02
      }else
      {
        page home_page_id
      }
    }
    // Down to Up
    swipec2=0-swipedy
    if(swipec<-100)
    {
      if(is_entitypage02==1) // Check if entitypage02 is active
      {
        if(is_entitypage03==1) // Then check if entitypage03 is also active
        {
          page entitypage03 // Navigate to entitypage03 if both are active
        }else if(is_entitypage04==1) // If entitypage03 is not active, but entitypage04 is
        {
          page entitypage04 // Navigate to entitypage04, skipping entitypage03
        }else
        {
          page home_page_id // Fallback if neither entitypage03 nor entitypage04 is active
        }
      }else if(is_entitypage03==1) // If entitypage02 is not active, check entitypage03 directly
      {
        if(is_entitypage04==1) // Check if entitypage04 is active
        {
          page entitypage04 // Navigate to entitypage04, effectively skipping two pages
        }else
        {
          page home_page_id // Fallback to home otherwise
        }
      }else
      {
        page home_page_id // Fallback to home if none of the conditions are met
      }
    }
  }

on swipestore.timer:
  swipex=tch0
  swipey=tch1

on button_back.down:
  page home_page_id
