on weather01.load:
  if(api==0)
  {
    page home_page_id
  }
  // set background image and fg color to all components
  if(theme==1)
  {
    weather_icon.pic=49
    // Page background
    b[0].pic=pic_background_main
    // button_back
    button_back.pco=color_pco_navigation
    button_back.picc=pic_background_main
    button_back.picc2=pic_background_main
    // day, date & temperature
    for(sys0=4;sys0<=6;sys0++)
    {
      b[sys0].picc=pic_background_main
      b[sys0].pco=color_pco_main
    }
    // values 01-05
    for(sys0=7;sys0<=16;sys0++)
    {
      b[sys0].picc=pic_background_main
      b[sys0].pco=color_pco_secondary
    }
    // page_index
    page_index.picc=pic_background_main
    page_index.pco=color_pco_navigation
  }
  // button_back font size
  button_back.font=button_back_font
  dim=brightness
  sendme

on swipe.down:
  swipestore.en=1 // Start swipestore timer

on swipe.up:
  swipestore.en=0
  // Touch has ended, x
  if(tch0==0)
  {
    swipec=swipex-tch2
    // From Left to Right
    if(swipec>swipedx)
    {
      page weather05
    }
    // Right to Left
    swipec2=0-swipedx
    if(swipec<swipec2)
    {
      page weather02
    }
  }
  // Touch has ended, y
  if(tch1==0)
  {
    swipec=swipey-tch3
    // From Up to Down
    if(swipec>100)
    {
      //page
    }
    // Down to Up
    swipec2=0-swipedy
    if(swipec<-100)
    {
      //page
    }
  }

on swipestore.timer:
  swipex=tch0
  swipey=tch1

on button_back.down:
  page home_page_id
