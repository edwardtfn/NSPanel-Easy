on alarm.load:
  dim=brightness
  if(api==0)
  {
    page home_page_id
  }else
  {
    vis bt_home,0
    vis bt_away,0
    vis bt_night,0
    vis bt_vacat,0
    vis bt_bypass,0
  }
  button_back.font=button_back_font
  sendme

on bt_home.down:
  bt_home_pic.pic=44
  bt_home_text.bco=65024
  bt_home_text.pco=0
  bt_home_icon.bco=65024
  bt_home_icon.pco=0

on bt_home.up:
  lastclick.txt="alarm,home,"+code_format.txt+","+code_arm_req.txt+","+bt_home_text.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lastclick.txt,0
  printh 00
  printh FF FF FF

on bt_away.down:
  bt_away_pic.pic=44
  bt_away_text.bco=65024
  bt_away_text.pco=0
  bt_away_icon.bco=65024
  bt_away_icon.pco=0

