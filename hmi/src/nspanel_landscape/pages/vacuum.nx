on vacuum.load:
  if(api==0)
  {
    page home_page_id
  }
  // Background and header
  vacuum.pic=pic_background_main
  icon_state.picc=pic_background_main
  icon_state.pco=color_pco_main
  page_label.picc=pic_background_main
  page_label.pco=color_pco_main
  button_back.font=button_back_font
  button_back.pco=color_pco_navigation
  button_back.picc=pic_background_main
  button_back.picc2=pic_background_main
  // State label
  state_label.picc=pic_background_main
  state_label.pco=color_pco_main
  // Vacuum picture (default: docked dark slot)
  vacuum_pic.pic=@pic(picture-0098)
  // Action buttons
  bt_start_pause.picc=pic_background_main
  bt_start_pause.pco=color_pco_secondary
  bt_stop.picc=pic_background_main
  bt_stop.pco=color_pco_secondary
  bt_return.picc=pic_background_main
  bt_return.pco=color_pco_secondary
  // Battery
  battery_icon.picc=pic_background_main
  battery_icon.pco=color_pco_main
  battery_value.picc=pic_background_main
  battery_value.pco=color_pco_main
  // Battery: hidden until Blueprint confirms BATTERY feature
  vis battery_icon,0
  vis battery_value,0
  dim=brightness
  sendme

on button_back.down:
  page back_page_id

on bt_start_pause.down:
  bt_start_pause.pco=color_pco_highlight

on bt_stop.down:
  bt_stop.pco=color_pco_highlight

on bt_return.down:
  bt_return.pco=color_pco_highlight
