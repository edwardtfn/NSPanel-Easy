on graph.load:
  if(api==0)
  {
    page home_page_id
  }
  // set background image and fg color to all components
  graph.pic=pic_background_main
  icon_state.picc=pic_background_main
  page_label.picc=pic_background_main
  button_back.font=button_back_font
  button_back.pco=color_pco_navigation
  button_back.picc2=pic_background_main
  wave.picc=pic_background_main
  wave.pco0=color_pco_main
  value_now.picc=pic_background_main
  value_now.pco=color_pco_main
  value_min.picc=pic_background_main
  value_min.pco=color_pco_secondary
  value_max.picc=pic_background_main
  value_max.pco=color_pco_secondary
  dim=brightness
  sendme

on button_back.down:
  page back_page_id

on draw_frame.down:
  // Restore the background below the waveform, where the ticks and hour labels are drawn
  sys0=wave.x-12
  sys1=wave.y+wave.h
  sys2=wave.w+24
  picq sys0,sys1,sys2,27,pic_background_main
  ref value_min
  // Lines at the top and bottom bounds
  sys0=wave.x+wave.w-1
  sys1=wave.y-1
  line wave.x,sys1,sys0,sys1,color_pco_navigation
  sys1=wave.y+wave.h
  line wave.x,sys1,sys0,sys1,color_pco_navigation

on draw_tick.down:
  sys0=wave.x+tick_x.val
  sys1=wave.y+wave.h
  sys2=sys1+4
  line sys0,sys1,sys0,sys2,color_pco_navigation
  sys0-=12
  sys2+=1
  xstr sys0,sys2,24,20,@font(font-01),color_pco_navigation,0,1,1,3,tick_text.txt
