on button_back.down:
  page back_page_id

on tm_chips.timer:
  // ESPHome and the Blueprint write the title and the state icon to the originals, hidden with the chips
  if(label_chips.txt!=page_label.txt)
  {
    label_chips.txt=page_label.txt
  }
  if(icon_chips.txt!=icon_state.txt)
  {
    icon_chips.txt=icon_state.txt
  }
  if(icon_chips.pco!=icon_state.pco)
  {
    icon_chips.pco=icon_state.pco
  }
