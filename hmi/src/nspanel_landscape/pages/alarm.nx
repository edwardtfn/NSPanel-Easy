on alarm.load:
  dim=brightness
  if(api==0)
  {
    page home_page_id
  }else
  {
    vis bt_home,0
    vis bt_away,0
    vis bt_night,0
    vis bt_vacat,0
    vis bt_bypass,0
  }
  button_back.font=button_back_font
  // Chips, at the same position as on the home page (shown when chips_alarm is set)
  for(sys0=31;sys0<=40;sys0++)
  {
    b[sys0].font=chip_font
    b[sys0].txt=""
  }
  if(chips_alarm==1)
  {
    // The state icon and the title go under the chips, copied from the originals (tm_chips)
    vis icon_state,0
    vis page_label,0
    sys0=31  // id of chip_relay1 on this page
    call chips_copy_home
    tm_chips.en=1
  }else
  {
    // No chips: the state icon and the title stay at the top, where the chips would be
    vis icon_chips,0
    vis label_chips,0
    for(sys0=31;sys0<=40;sys0++)
    {
      vis sys0,0
    }
  }
  sendme

on bt_home.down:
  bt_home_pic.pic=@pic(picture-0044)
  bt_home_text.bco=65024
  bt_home_text.pco=0
  bt_home_icon.bco=65024
  bt_home_icon.pco=0

on bt_home.up:
  lastclick.txt="alarm,home,"+code_format.txt+","+code_arm_req.txt+","+bt_home_text.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lastclick.txt,0
  printh 00
  printh FF FF FF

