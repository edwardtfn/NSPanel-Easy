on screensaver.load:
  if(esphome==0)
  {
    // Power on: ESPHome did not connect yet, so nothing can be used. The touch is off and
    // boot_wait watches for ESPHome, which opens the wake-up page when it connects.
    tsw 255,0
    boot_count.val=0
    boot_wait.en=1
    // Start screen: a dimmed watermark instead of a black screen, kept until ESPHome opens a page.
    // The screensaver settings come from ESPHome, so they are not applied yet.
    apply_settings.en=0
    text.font=4
    text.pco=16904  // Dark gray
    text.txt="NSPanel Easy"
    dim=15
  }
  // restore chips
  for(sys0=6;sys0<=15;sys0++)
  {
    b[sys0].bco=screensaver.bco
    b[sys0].font=chip_font
  }
  if(chips_screensaver==1)
  {
    sys0=6  // id of chip_relay1 on this page
    call chips_copy_home
  }
  sendme

on screensaver.up:
  page wakeup_page_id

on wakeup.down:
  page wakeup_page_id

on swipe.down:
  swipestore.en=1 // Start swipestore timer

on swipe.up:
  swipestore.en=0
  // Touch has ended, x
  if(tch0==0)
  {
    swipec=swipex-tch2
    // From Left to Right
    if(swipec>swipedx&&api==1)
    {
      page buttonpage04
    }
    // Right to Left
    swipec2=0-swipedx
    if(swipec<swipec2&&api==1)
    {
      page buttonpage01
    }
  }
  // Touch has ended, y
  if(tch1==0)
  {
    swipec=swipey-tch3
    // From Up to Down
    if(swipec>100&&api==1)
    {
      page buttonpage02
    }
    // Down to Up
    swipec2=0-swipedy
    if(swipec<-100&&api==1)
    {
      page buttonpage03
    }
  }

on swipestore.timer:
  swipex=tch0
  swipey=tch1

on text.up:
  page wakeup_page_id

on apply_settings.timer:
  apply_settings.en=0
  dim=brightness_sleep
  // Only what changed: writing an attribute redraws, and the whole page for the page's background
  if(screensaver.bco!=screensaver_bco)
  {
    screensaver.bco=screensaver_bco
  }
  if(text.bco!=screensaver_bco)
  {
    text.bco=screensaver_bco
  }
  if(text.font!=screensaver_font)
  {
    text.font=screensaver_font
  }
  if(text.pco!=screensaver_pco)
  {
    text.pco=screensaver_pco
  }

on chip_relay1.up:
  page wakeup_page_id

on chip_relay2.up:
  page wakeup_page_id

on chip_climate.up:
  page wakeup_page_id

on chip01.up:
  page wakeup_page_id

on chip02.up:
  page wakeup_page_id

on chip03.up:
  page wakeup_page_id

on chip04.up:
  page wakeup_page_id

on chip05.up:
  page wakeup_page_id

on chip06.up:
  page wakeup_page_id

on chip07.up:
  page wakeup_page_id

on boot_wait.timer:
  // Runs only after power on, until ESPHome connects (esphome=1) and takes over.
  // Without ESPHome for too long, the boot page tells what is wrong.
  if(esphome==1)
  {
    boot_wait.en=0
    tsw 255,1
  }else
  {
    boot_count.val++
    if(boot_count.val>20)
    {
      page boot
    }
  }
