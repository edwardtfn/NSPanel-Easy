on entitypage03.load:
  if(api==0)
  {
    page home_page_id
  }
  sys0=is_entitypage01+is_entitypage02+is_entitypage03+is_entitypage04
  if(sys0>1)
  {
    if(is_entitypage01==1)
    {
      page_index.txt+="○"
    }
    if(is_entitypage02==1)
    {
      page_index.txt+="○"
    }
    page_index.txt+="●"
    if(is_entitypage04==1)
    {
      page_index.txt+="○"
    }
  }else
  {
    vis page_index,0
  }
  // set background image and fg color to all components
  b[0].pic=pic_background_main
  for(sys0=3;sys0<=29;sys0++)
  {
    b[sys0].picc=pic_background_main
    b[sys0].pco=color_pco_main
  }
  button_back.font=button_back_font
  button_back.picc2=pic_background_main
  button_back.pco=color_pco_navigation
  page_index.pco=color_pco_navigation
  dim=brightness
  sendme

on swipe.down:
  swipestore.en=1 // Start swipestore timer

on swipe.up:
  if(api==0)
  {
    page home_page_id
  }
  swipestore.en=0
  // Touch has ended, x
  if(tch0==0)
  {
    swipec=swipex-tch2
    // From Left to Right
    if(swipec>swipedx)
    {
      if(is_entitypage02==1)
      {
        page entitypage02
      }else if(is_entitypage01==1)
      {
        page entitypage01
      }else
      {
        page home_page_id
      }
    }
    // Right to Left
    swipec2=0-swipedx
    if(swipec<swipec2)
    {
      if(is_entitypage04==1)
      {
        page entitypage04
      }else
      {
        page home_page_id
      }
    }
  }
  // Touch has ended, y
  if(tch1==0)
  {
    swipec=swipey-tch3
    // From Up to Down
    if(swipec>100)
    {
      if(is_entitypage02==1&&is_entitypage01==1)
      {
        page entitypage01
      }else if(is_entitypage02==1||is_entitypage01==1||is_entitypage04==0)
      {
        page home_page_id
      }else
      {
        page entitypage04
      }
    }
    // Down to Up
    swipec2=0-swipedy
    if(swipec<-100)
    {
      if(is_entitypage04==1)
      {
        page home_page_id
      }else if(is_entitypage01==1)
      {
        page entitypage01
      }else if(is_entitypage02==1)
      {
        page entitypage02
      }else
      {
        page home_page_id
      }
    }
  }

on swipestore.timer:
  swipex=tch0
  swipey=tch1

on button_back.down:
  page home_page_id
