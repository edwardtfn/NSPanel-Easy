on short_click_tm.timer:
  click_timer.en=0
  short_click_tm.en=0
  if(click_comp.txt!="")
  {
    lastclick.txt="home,short_click,"+click_comp.txt
    printh 92
    prints "localevent",0
    printh 00
    prints lastclick.txt,0
    printh 00
    printh FF FF FF
    click_comp.txt=""
  }
