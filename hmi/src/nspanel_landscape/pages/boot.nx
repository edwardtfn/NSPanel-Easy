on boot.load:
  // Only shown when ESPHome does not connect or on request, so it is always bright enough to be read
  dim=100
  covx baud,tmp_baudrate.txt,0,0
  sys_baudrate.txt="Baud rate: "
  sys_baudrate.txt+=tmp_baudrate.txt
  sys_baudrate.txt+=" bps"
  ver_tft.txt="TFT: "+version.txt
  sendme

on boot.loadend:
  line 216,72,450,72,WHITE
  line 450,72,450,318,WHITE
  line 216,72,216,318,WHITE
  line 216,318,450,318,WHITE
  line 218,74,448,74,WHITE
  line 448,74,448,316,WHITE
  line 218,74,218,316,WHITE
  line 218,316,450,316,WHITE
  vis log_title,1
  line 14,72,200,72,WHITE
  line 200,72,200,188,WHITE
  line 14,72,14,188,WHITE
  line 14,188,200,188,WHITE
  line 16,74,198,74,WHITE
  line 198,74,198,186,WHITE
  line 16,74,16,186,WHITE
  line 16,186,200,186,WHITE
  vis ver_title,1
  line 14,202,200,202,WHITE
  line 200,202,200,318,WHITE
  line 14,202,14,318,WHITE
  line 14,318,200,318,WHITE
  line 16,204,198,204,WHITE
  line 198,204,198,316,WHITE
  line 16,204,16,316,WHITE
  line 16,316,200,316,WHITE
  vis sys_title,1

on log_scroll.timer:
  strlen log_body.txt,log_len.val
  log_pos.val=0
  log_line_count.val=0
  log_start_pos.val=0
  log_end_pos.val=0
  log_temp.txt=""
  // Count the number of lines (instances of \r)
  while(log_pos.val<log_len.val)
  {
    // Extract each character to find \r
    substr log_body.txt,log_temp.txt,log_pos.val,2
    if(log_temp.txt=="\r")
    {
      log_line_count.val++
      // Record the position of the first \r
      if(log_line_count.val==1)
      {
        log_start_pos.val=log_pos.val
      }
      // Record the position of the second \r
      if(log_line_count.val==2)
      {
        log_end_pos.val=log_pos.val
      }
    }
    log_pos.val++
  }
  // Check if the number of lines exceeds the maximum allowed
  if(log_line_count.val>log_max_lines.val)
  {
    // If more than max_lines, remove the first line
    if(log_end_pos.val>0)
    {
      // Remove the first line including the newline character
      substr log_body.txt,log_body.txt,log_start_pos.val+1,log_len.val-log_start_pos.val-1
    }
  }
  doevents

on bt_reboot.up:
  log_body.txt+="Click button 'Reboot'\r"
  if(api==0)
  {
    rest
  }

on tm_esphome.timer:
  // Only waits for ESPHome, which asks for the display settings when it connects (macro
  // report_display) and sets `esphome`. Without ESPHome for a minute, the display restarts.
  if(esphome==1)
  {
    tm_esphome.en=0
  }
  counter.val++
  if(counter.val>60)
  {
    rest
  }

on tm_display_ack.timer:
  if(display_ack>0)
  {
    tm_display_ack.en=0
  }else
  {
    // Send aknowledge flag to ESPHome
    printh 93
    prints "display_ack",0
    printh 00 01 FF FF FF
  }
