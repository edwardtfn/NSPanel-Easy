  line 16,204,16,316,WHITE
  line 16,316,200,316,WHITE
  vis sys_title,1

on tm_status.timer:
  // The status known by the display, rebuilt every second while the page is shown, so it follows the connections.
  // Built in va1 and copied once, so the text is only redrawn when it changes.
  va1.txt="ESPHome: "
  if(esphome==1)
  {
    va1.txt+="Yes"
  }else
  {
    va1.txt+="No"
  }
  va1.txt+="  HA: "
  if(api==1)
  {
    va1.txt+="Yes"
  }else
  {
    va1.txt+="No"
  }
  va1.txt+="Model: "
  covx display_mode,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" (TFT "
  covx hard_coded_display_mode,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=")  Ack: "
  covx display_ack,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Pages: home "
  covx home_page_id,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" wake "
  covx wakeup_page_id,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" back "
  covx back_page_id,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Brightness: "
  covx brightness,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="/"
  covx brightness_dim,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="/"
  covx brightness_sleep,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Backlight: "
  covx dim,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="  Recmod: "
  covx recmod,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Thermostat: "
  covx climate_embedded,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="  Home: "
  covx vis_home,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Button pages: "
  covx is_buttonpage01,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_buttonpage02,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_buttonpage03,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_buttonpage04,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+="Entity pages: "
  covx is_entitypage01,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_entitypage02,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_entitypage03,va0.txt,0,0
  va1.txt+=va0.txt
  va1.txt+=" "
  covx is_entitypage04,va0.txt,0,0
  va1.txt+=va0.txt
  if(stat_body.txt!=va1.txt)
  {
    stat_body.txt=va1.txt
  }

on bt_reboot.up:
  if(api==0)
  {
    rest
  }

on tm_esphome.timer:
  // Only waits for ESPHome, which asks for the display settings when it connects (macro
  // report_display) and sets `esphome`. Without ESPHome for a minute, the display restarts.
  if(esphome==1)
  {
    tm_esphome.en=0
  }
  counter.val++
  if(counter.val>60)
  {
    rest
  }

on tm_display_ack.timer:
  if(display_ack>0)
  {
    tm_display_ack.en=0
  }else
  {
    // Send aknowledge flag to ESPHome
    printh 93
    prints "display_ack",0
    printh 00 01 FF FF FF
  }

on button_back.down:
  page home_page_id
