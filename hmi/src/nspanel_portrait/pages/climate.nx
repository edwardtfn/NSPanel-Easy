on timer0.timer:
  timer0.en=0
  covx temp_number0.val,va2.txt,0,0
  climatesetting.txt="climate,temperature,"+va2.txt
  printh 92
  prints "localevent",0
  printh 00
  prints climatesetting.txt,0
  printh 00
  printh FF FF FF

on button08.down:
  click_comp.txt="button08"
  click_timer.en=1

on button08.up:
  if(click_timer.en==1)
  {
    click_timer.en=0
    lastclick.txt="climate,short_click,"+click_comp.txt
    printh 92
    prints "localevent",0
    printh 00
    prints lastclick.txt,0
    printh 00
    printh FF FF FF
  }

on button09.down:
  click_comp.txt="button09"
  click_timer.en=1

on button09.up:
  if(click_timer.en==1)
  {
    click_timer.en=0
    lastclick.txt="climate,short_click,"+click_comp.txt
    printh 92
    prints "localevent",0
    printh 00
    prints lastclick.txt,0
    printh 00
    printh FF FF FF
  }

on target_high.up:
  active_slider.val=is_temp_range.val

on button_back.down:
  page back_page_id

on click_timer.timer:
  lastclick.txt="climate,long_click,"+click_comp.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lastclick.txt,0
  printh 00
  printh FF FF FF
  click_timer.en=0

on slider_low.down:
  temp_gap.val=3*temp_step.val
  temp_low_max.val=slider_high.val-temp_gap.val

on slider_low.up:
  if(slider_low.val>temp_low_max.val)
  {
    slider_low.val=temp_low_max.val
  }
  temp_number2.val=slider_low.val*temp_step.val
  temp_number2.val+=temp_offset.val
  sys0=temp_number2.val
  sys1=temp_step.val
  call format_tenths
  target_low.txt=home.tenths_txt.txt+temp_unit.txt
  timer2.en=1
  active_slider.val=2
  temp_gap.val=3*temp_step.val
  temp_high_min.val=slider_low.val+temp_gap.val

on slider_low.slide:
  if(slider_low.val>temp_low_max.val)
  {
    slider_low.val=temp_low_max.val
  }
  temp_number2.val=slider_low.val*temp_step.val
  temp_number2.val+=temp_offset.val
  sys0=temp_number2.val
  sys1=temp_step.val
  call format_tenths
  target_low.txt=home.tenths_txt.txt+temp_unit.txt

on target_low.up:
  active_slider.val=2

on climateslider.up:
  temp_number0.val=climateslider.val*temp_step.val
  temp_number0.val+=temp_offset.val
  sys0=temp_number0.val
  sys1=temp_step.val
  call format_tenths
  target_high.txt=home.tenths_txt.txt+temp_unit.txt
  active_slider.val=0
  timer0.en=1

on climateslider.slide:
  temp_number0.val=climateslider.val*temp_step.val
  temp_number0.val+=temp_offset.val
  sys0=temp_number0.val
  sys1=temp_step.val
  call format_tenths
  target_high.txt=home.tenths_txt.txt+temp_unit.txt

on timer1.timer:
  timer1.en=0
  covx temp_number1.val,va2.txt,0,0
  climatesetting.txt="climate,target_temp_high,"+va2.txt
  printh 92
  prints "localevent",0
  printh 00
  prints climatesetting.txt,0
  printh 00
  printh FF FF FF

on timer2.timer:
  timer2.en=0
  covx temp_number2.val,va2.txt,0,0
  climatesetting.txt="climate,target_temp_low,"+va2.txt
  printh 92
  prints "localevent",0
  printh 00
  prints climatesetting.txt,0
  printh 00
  printh FF FF FF

on preset_button.down:
  preset_button.pco=31

on fan_button.down:
  fan_button.pco=31
