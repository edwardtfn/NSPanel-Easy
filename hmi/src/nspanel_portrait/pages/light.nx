on light.load:
  if(api==0)
  {
    page home_page_id
  }
  // Hide new hotspots
  vis sub_calc,0
  vis sub_hsv,0
  vis sub_send,0
  // All tab controls hidden by default; mask-driven logic below sets visibility
  vis light_button,0
  vis lightslider,0
  vis light_value,0
  vis light_value_2,0
  vis temp_button,0
  vis tempslider,0
  vis temp_value,0
  vis temp_value_2,0
  vis color_button,0
  vis colorwheel,0
  vis effect_button,0
  // vis power_button,0 // Light always have on/off
  light_value.pco=color_pco_main
  light_value_2.pco=color_pco_main
  temp_value.pco=color_pco_main
  temp_value_2.pco=color_pco_main
  effect_button.pco=color_pco_secondary
  effect_label.pco=color_pco_secondary
  power_button.pco=color_pco_secondary
  // Back button (shown on all pages)
  button_back.font=button_back_font
  button_back.pco=color_pco_navigation
  // Header (shown on all pages)
  icon_state.pco=color_pco_main
  page_label.pco=color_pco_main
  // Light mode only: override HMI defaults (which target dark theme).
  // Dark theme uses the component defaults directly, so no else branch.
  if(theme==1)
  {
    // Page background
    light.pic=pic_background_main
    // Brightness control components
    light_button.pic=@pic(picture-0076)
    light_button.pic2=@pic(picture-0067)
    lightslider.pic=@pic(picture-0072)
    lightslider.pic1=@pic(picture-0073)
    light_value.picc=pic_background_main
    light_value_2.picc=pic_background_main
    // Temp control components
    temp_button.pic=@pic(picture-0077)
    temp_button.pic2=@pic(picture-0068)
    tempslider.pic=@pic(picture-0071)
    tempslider.pic1=@pic(picture-0071)
    temp_value.picc=pic_background_main
    temp_value_2.picc=pic_background_main
    // Color control components
    color_button.pic=@pic(picture-0078)
    color_button.pic2=@pic(picture-0069)
    colorwheel.pic=@pic(picture-0070)
    // Effect button
    effect_button.picc=pic_background_main
    effect_label.picc=pic_background_main
    // Power button
    power_button.picc=pic_background_main
    // Back button (two picc slots: released / pressed)
    button_back.picc=pic_background_main
    button_back.picc2=pic_background_main
    // Header components
    icon_state.picc=pic_background_main
    page_label.picc=pic_background_main
  }
  dim=brightness
  sendme

on light.unload:
  light_features_mask=0

on lightslider.up:
  covx lightslider.val,va1.txt,0,0
  light_value.txt=va1.txt
  light_value.txt+=home.units_sep.txt
  light_value.txt+="%"
  light_value_2.txt=va1.txt
  light_value_2.txt+=home.units_sep.txt
  light_value_2.txt+="%"
  lightsetting.txt="light,brightness_pct,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lightsetting.txt,0
  printh 00
  printh FF FF FF

on lightslider.slide:
  covx lightslider.val,va1.txt,0,0
  light_value.txt=va1.txt
  light_value.txt+=home.units_sep.txt
  light_value.txt+="%"
  light_value_2.txt=va1.txt
  light_value_2.txt+=home.units_sep.txt
  light_value_2.txt+="%"

on hsv2rgb.up:
  // https://de.wikipedia.org/wiki/HSV-Farbraum#Umrechnung_HSV_in_RGB
  // The values range from 0..255 instead of 0..1
  // h ranges from 0..(6*256)
  if(s.val>=256)
  {
    s.val=255
  }else if(s.val<0)
  {
    s.val=0
  }
  if(v.val>=256)
  {
    v.val=255
  }else if(v.val<0)
  {
    v.val=0
  }
  f.val=h.val&0xff
  p.val=256-s.val
  p.val*=v.val
  p.val=p.val>>8// / 256
  q.val=s.val*f.val// 0-256*256 = 0-65536
  q.val=65536-q.val
  q.val*=v.val
  q.val=q.val>>16
  t.val=256-f.val
  t.val*=s.val
  t.val=65536-t.val
  t.val*=v.val
  t.val=t.val>>16
  //
  f.val=h.val>>8
  if(f.val==1)
  {
    r.val=q.val
    g.val=v.val
    b.val=p.val
  }else if(f.val==2)
  {
    r.val=p.val
    g.val=v.val
    b.val=t.val
  }else if(f.val==3)
  {
    r.val=p.val
    g.val=q.val
    b.val=v.val
  }else if(f.val==4)
  {
    r.val=t.val
    g.val=p.val
    b.val=v.val
  }else if(f.val==5)
  {
    r.val=v.val
    g.val=p.val
    b.val=q.val
  }else
  {
    r.val=v.val
    g.val=t.val
    b.val=p.val
  }

on rgb888to565.up:
  r.val=r.val&0xff
  g.val=g.val&0xff
  b.val=b.val&0xff
  sys1=r.val>>3
  sys2=sys1<<6
  sys1=g.val>>2
  sys2+=sys1
  sys2=sys2<<5
  sys1=b.val>>3
  sys2+=sys1
  rgb565.val=sys2

on tempslider.up:
  sys0=tempslider.minval+tempslider.maxval-tempslider.val
  covx sys0,va1.txt,0,0
  temp_value.txt=va1.txt
  temp_value.txt+=home.units_sep.txt
  temp_value.txt+="K"
  temp_value_2.txt=va1.txt
  temp_value_2.txt+=home.units_sep.txt
  temp_value_2.txt+="K"
  lightsetting.txt="light,color_temp_kelvin,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lightsetting.txt,0
  printh 00
  printh FF FF FF

on tempslider.slide:
  sys0=tempslider.minval+tempslider.maxval-tempslider.val
  covx sys0,va1.txt,0,0
  temp_value.txt=va1.txt
  temp_value.txt+=home.units_sep.txt
  temp_value.txt+="K"
  temp_value_2.txt=va1.txt
  temp_value_2.txt+=home.units_sep.txt
  temp_value_2.txt+="K"

on colorwheel.down:
  // Mark wheel as actively touched.
  va_active.val=1
  va_idle.val=0
  va_committed.val=0
  //
  // Compute initial field/ring from press coords.
  sya0=tch0
  sya1=tch1
  sys0=colorwheel.w/2
  sys0+=colorwheel.x
  sys1=colorwheel.h/2
  sys1+=colorwheel.y
  sya0-=sys0
  sya1-=sys1
  click sub_calc,1
  //
  // Save as last values, update preview.
  va_lastF.val=field.val
  va_lastR.val=ring.val
  click sub_hsv,1
  //
  // Start polling.
  tm_poll.en=1

on colorwheel.up:
  // Stop polling.
  tm_poll.en=0
  va_active.val=0
  //
  // If we haven't already committed during idle, send now.
  if(va_committed.val==0)
  {
    click sub_send,1
  }

on button_back.down:
  page back_page_id

on power_button.up:
  power_button.pco=31

on effect_button.up:
  effect_button.pco=31

on light_button.down:
  // Show brightness controls
  light_button.val=1
  vis lightslider,1
  vis light_value,1
  vis light_value_2,1
  // Hide temperature controls
  temp_button.val=0
  vis tempslider,0
  vis temp_value,0
  // Hide color controls
  color_button.val=0
  vis colorwheel,0

on temp_button.down:
  // Hide brightness controls
  light_button.val=0
  vis lightslider,0
  vis light_value,0
  // Show temperature controls
  temp_button.val=1
  vis tempslider,1
  vis temp_value,1
  vis temp_value_2,1
  // Hide color controls
  color_button.val=0
  vis colorwheel,0

on color_button.down:
  // Hide brightness controls
  light_button.val=0
  vis lightslider,0
  vis light_value,0
  // Hide temperature controls
  temp_button.val=0
  vis tempslider,0
  vis temp_value,0
  // Hide color controls
  color_button.val=1
  vis colorwheel,1

on sub_calc.down:
  // Field/ring calculation subroutine. Reads sya0, sya1 (relative coords).
  // Writes field.val and ring.val.
  // Caller must set sya0, sya1 before calling: click sub_calc,1
  //
  // Determine ring (squared radius comparison).
  ring.val=0
  sys0=sya0*sya0
  sys1=sya1*sya1
  sys0+=sys1
  if(sys0>=156)
  {
    ring.val++
  }
  if(sys0>=625)
  {
    ring.val++
  }
  if(sys0>=1406)
  {
    ring.val++
  }
  if(sys0>=2500)
  {
    ring.val++
  }
  if(sys0>=3906)
  {
    ring.val++
  }
  if(sys0>=5625)
  {
    ring.val++
  }
  if(sys0>=7656)
  {
    ring.val++
  }
  //
  // Determine quadrant. Pixel y is inverted vs. math y.
  sya1*=-1
  sys2=0
  if(sya1<0)
  {
    sys2+=2
  }
  sys0=sya0*sya1
  if(sys0<0)
  {
    sys2+=1
    sys1=sya1
    sya1=sya0
    sya0=sys1
  }
  field.val=sys2*6
  //
  // Drop signs.
  if(sya0<0)
  {
    sya0*=-1
  }
  if(sya1<0)
  {
    sya1*=-1
  }
  //
  // Determine field within quadrant (tan*100000 comparison).
  // Guard against division by zero when touch is exactly on the vertical axis
  // (sya0==0 means tan(angle)=infinity, which falls past every threshold).
  if(sya0==0)
  {
    field.val+=5
  }else
  {
    sys0=100000*sya1
    sys0/=sya0
    if(sys0>=26794)
    {
      field.val++
    }
    if(sys0>=57735)
    {
      field.val++
    }
    if(sys0>=99999)
    {
      field.val++
    }
    if(sys0>=173205)
    {
      field.val++
    }
    if(sys0>=373205)
    {
      field.val++
    }
  }

on tm_poll.timer:
  // Safety: if not active, disable and bail.
  if(va_active.val==0)
  {
    tm_poll.en=0
  }
  //
  // Pre-compute bounds (Nextion if doesn't accept inline math).
  sys0=colorwheel.x
  sys1=colorwheel.x+colorwheel.w
  sys2=colorwheel.y
  sya0=colorwheel.y+colorwheel.h
  //
  // Bounds check: ignore samples outside the wheel.
  // Keeps last valid field/ring per design choice.
  if(tch0<sys0)
  {
    tm_poll.en=tm_poll.en
  }else if(tch0>=sys1)
  {
    tm_poll.en=tm_poll.en
  }else if(tch1<sys2)
  {
    tm_poll.en=tm_poll.en
  }else if(tch1>=sya0)
  {
    tm_poll.en=tm_poll.en
  }else
  {
    // In bounds. Compute relative coords and run calc.
    sya0=tch0
    sya1=tch1
    sys0=colorwheel.w/2
    sys0+=colorwheel.x
    sys1=colorwheel.h/2
    sys1+=colorwheel.y
    sya0-=sys0
    sya1-=sys1
    click sub_calc,1
    //
    // Did field or ring change?
    if(field.val!=va_lastF.val)
    {
      va_lastF.val=field.val
      va_lastR.val=ring.val
      va_idle.val=0
      va_committed.val=0
      click sub_hsv,1
    }else if(ring.val!=va_lastR.val)
    {
      va_lastF.val=field.val
      va_lastR.val=ring.val
      va_idle.val=0
      va_committed.val=0
      click sub_hsv,1
    }else
    {
      // No change. Bump idle counter.
      va_idle.val++
      if(va_idle.val>=10)
      {
        // 10 ticks * 100ms = 1s of stillness. Commit.
        if(va_committed.val==0)
        {
          click sub_send,1
        }
      }
    }
  }

on sub_hsv.down:
  // HSV preview subroutine. Reads field.val, ring.val.
  // Computes RGB and draws preview circle inside color_button.
  // Does NOT send to HA.
  //
  h.val=23-field.val
  h.val*=6*256
  h.val/=24
  //
  s.val=ring.val*256
  s.val/=8
  //
  v.val=255
  click hsv2rgb,0
  click rgb888to565,0
  //
  // Draw filled preview circle, full size of color_button minus 1px margin.
  // Center: (x + w/2, y + h/2). Radius: min(w,h)/2 - 1.
  sys0=color_button.w
  sys0/=2
  sys0+=color_button.x
  sys1=color_button.h
  sys1/=2
  sys1+=color_button.y
  sys2=color_button.w
  if(color_button.h<sys2)
  {
    sys2=color_button.h
  }
  sys2/=2
  cirs sys0,sys1,sys2,rgb565.val

on sub_send.down:
  // Send current color to HA. Reads r.val, g.val, b.val (already computed by sub_hsv).
  covx r.val,va1.txt,0,0
  covx g.val,va2.txt,0,0
  covx b.val,va3.txt,0,0
  lightsetting.txt="light,rgb_color,"+va1.txt+","+va2.txt+","+va3.txt
  printh 92
  prints "localevent",0
  printh 00
  prints lightsetting.txt,0
  printh 00
  printh FF FF FF
  va1.txt=""
  va2.txt=""
  va3.txt=""
  va_committed.val=1

on features.timer:
  if(light_features_mask>0)
  {
    features.en=0
    // Feature mask: bit0=brightness, bit1=temp, bit2=color, bit3=effects
    // Show tab buttons for supported features only; activate highest-priority tab
    sys0=light_features_mask&1
    sys1=0
    if(sys0>0)
    {
      vis light_button,1
      light_button.val=1
      vis lightslider,1
      vis light_value,1
      vis light_value_2,1
      sys1=1
    }
    sys0=light_features_mask&2
    if(sys0>0)
    {
      vis temp_button,1
      if(sys1==0)
      {
        temp_button.val=1
        vis tempslider,1
        vis temp_value,1
        vis temp_value_2,1
        sys1=1
      }
    }
    sys0=light_features_mask&4
    if(sys0>0)
    {
      vis color_button,1
      if(sys1==0)
      {
        color_button.val=1
        vis colorwheel,1
      }
    }
    sys0=light_features_mask&8
    if(sys0>0)
    {
      vis effect_button,1
    }
  }
