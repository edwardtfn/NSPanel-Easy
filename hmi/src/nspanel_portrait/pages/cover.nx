on cover.load:
  if(api==0)
  {
    page home_page_id
  }
  // set background image and fg color to all components
  if(theme==1)
  {
    cover.pic=pic_background_main
    icon_state.picc=pic_background_main
    icon_state.pco=color_pco_main
    page_label.picc=pic_background_main
    page_label.pco=color_pco_main
    button_back.font=button_back_font
    button_back.pco=color_pco_navigation
    button_back.picc=pic_background_main
    button_back.picc2=pic_background_main
    cover_value.picc=pic_background_main
    cover_value.pco=color_pco_main
    cover_value_2.picc=pic_background_main
    cover_value_2.pco=color_pco_main
    tilt_value.picc=pic_background_main
    tilt_value.pco=color_pco_main
    battery_icon.picc=pic_background_main
    battery_icon.pco=color_pco_main
    battery_value.picc=pic_background_main
    battery_value.pco=color_pco_main
    cover_open.picc=pic_background_main
    cover_open.picc2=pic_background_main
    cover_open.pco=color_pco_main
    cover_close.picc=pic_background_main
    cover_close.picc2=pic_background_main
    cover_close.pco=color_pco_main
    cover_stop.picc=pic_background_main
    cover_stop.picc2=pic_background_main
    cover_stop.pco=color_pco_main
  }
  vis coverslider,0
  vis cover_value,0
  vis coverslider2,0
  vis cover_value_2,0
  vis tiltslider,0
  vis tilt_value,0
  dim=brightness
  sendme

on cover_open.down:
  printh 92
  prints "localevent",0
  printh 00
  prints "cover,open_cover",0
  printh 00
  printh FF FF FF

on cover_close.down:
  printh 92
  prints "localevent",0
  printh 00
  prints "cover,close_cover",0
  printh 00
  printh FF FF FF

on coverslider2.up:
  covx coverslider2.val,va1.txt,0,0
  cover_value_2.txt=va1.txt
  cover_value_2.txt+=home.units_sep.txt
  cover_value_2.txt+="%"
  coversetting.txt="cover,position,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints coversetting.txt,0
  printh 00
  printh FF FF FF

on coverslider2.slide:
  covx coverslider2.val,va1.txt,0,0
  cover_value_2.txt=va1.txt
  cover_value_2.txt+=home.units_sep.txt
  cover_value_2.txt+="%"

on cover_stop.down:
  printh 92
  prints "localevent",0
  printh 00
  prints "cover,stop_cover",0
  printh 00
  printh FF FF FF

on button_back.down:
  page back_page_id

on coverslider.up:
  covx coverslider.val,va1.txt,0,0
  cover_value.txt=va1.txt
  cover_value.txt+=home.units_sep.txt
  cover_value.txt+="%"
  coversetting.txt="cover,position,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints coversetting.txt,0
  printh 00
  printh FF FF FF

on coverslider.slide:
  covx coverslider.val,va1.txt,0,0
  cover_value.txt=va1.txt
  cover_value.txt+=home.units_sep.txt
  cover_value.txt+="%"

on tiltslider.up:
  covx tiltslider.val,va1.txt,0,0
  tilt_value.txt=va1.txt
  tilt_value.txt+=home.units_sep.txt
  tilt_value.txt+="%"
  coversetting.txt="cover,tilt_position,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints coversetting.txt,0
  printh 00
  printh FF FF FF

on tiltslider.slide:
  covx tiltslider.val,va1.txt,0,0
  tilt_value.txt=va1.txt
  tilt_value.txt+=home.units_sep.txt
  tilt_value.txt+="%"
