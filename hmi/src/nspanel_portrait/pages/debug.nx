on debug.load:
  global_vars.txt+="\r- home_page_id: "
  covx home_page_id,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- back_page_id: "
  covx back_page_id,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- wakeup_page_id: "
  covx wakeup_page_id,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- api: "
  covx api,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- brightness: "
