  global_vars.txt+=aux.txt
  global_vars.txt+="\r- display_mode: "
  covx display_mode,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- climate_embedded: "
  covx climate_embedded,aux.txt,0,0
  global_vars.txt+=aux.txt
  global_vars.txt+="\r- vis_home: "
  covx vis_home,aux.txt,0,0
  global_vars.txt+=aux.txt
  pages_flags.txt+="\r- is_buttonpage01: "
  covx is_buttonpage01,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_buttonpage02: "
  covx is_buttonpage02,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_buttonpage03: "
  covx is_buttonpage03,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_buttonpage04: "
  covx is_buttonpage04,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_entitypage01: "
  covx is_entitypage01,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_entitypage02: "
  covx is_entitypage02,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_entitypage03: "
  covx is_entitypage03,aux.txt,0,0
  pages_flags.txt+=aux.txt
  pages_flags.txt+="\r- is_entitypage04: "
