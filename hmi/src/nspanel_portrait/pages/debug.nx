  covx baud,aux.txt,0,0
  system_vars.txt+=aux.txt
  system_vars.txt+="\r- recmod: "
  covx recmod,aux.txt,0,0
  system_vars.txt+=aux.txt
  system_vars.txt+="\r- dim: "
  covx dim,aux.txt,0,0
  system_vars.txt+=aux.txt
  button_back.font=button_back_font
  sendme

on button_back.down:
  page home_page_id
