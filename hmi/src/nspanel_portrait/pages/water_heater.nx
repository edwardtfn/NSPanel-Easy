on button_back.down:
  page back_page_id

on slider.up:
  temp_number0.val=slider.val*temp_step.val
  temp_number0.val+=temp_offset.val
  sys0=temp_number0.val
  sys1=temp_step.val
  call format_tenths
  target.txt=home.tenths_txt.txt+temp_unit.txt
  timer0.en=1

on slider.slide:
  temp_number0.val=slider.val*temp_step.val
  temp_number0.val+=temp_offset.val
  sys0=temp_number0.val
  sys1=temp_step.val
  call format_tenths
  target.txt=home.tenths_txt.txt+temp_unit.txt

on timer0.timer:
  timer0.en=0
  covx temp_number0.val,va1.txt,0,0
  climatesetting.txt="water_heater,temperature,"+va1.txt
  printh 92
  prints "localevent",0
  printh 00
  prints climatesetting.txt,0
  printh 00
  printh FF FF FF
