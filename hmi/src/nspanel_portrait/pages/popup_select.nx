on popup_select.load:
  dim=brightness
  vis 255,0
  sendme

on popup_select.up:
  // Close the picker only when the tap lands outside the card
  if(display_mode==2)
  {
    sys0=20   // card left (portrait)
    sys1=300  // card right
    sys2=40   // card top
  }else
  {
    sys0=50   // card left (landscape)
    sys1=400  // card right
    sys2=20   // card top
  }
  if(tch2<sys0)
  {
    page caller_page_id.val
  }else if(tch2>sys1)
  {
    page caller_page_id.val
  }else if(tch3<sys2)
  {
    page caller_page_id.val
  }else
  {
    sys2+=card_h.val  // card bottom
    if(tch3>sys2)
    {
      page caller_page_id.val
    }
  }

on btn_back.up:
  page caller_page_id.val

on opt0.down:
  press_y.val=tch1

on opt0.up:
  tap_slot.val=0
  tap_eval.en=1

on opt1.down:
  press_y.val=tch1

on opt1.up:
  tap_slot.val=1
  tap_eval.en=1

on opt2.down:
  press_y.val=tch1

on opt2.up:
  tap_slot.val=2
  tap_eval.en=1

on opt3.down:
  press_y.val=tch1

on opt3.up:
  tap_slot.val=3
  tap_eval.en=1

on opt4.down:
  press_y.val=tch1

on opt4.up:
  tap_slot.val=4
  tap_eval.en=1

on opt5.down:
  press_y.val=tch1

on opt5.up:
  tap_slot.val=5
  tap_eval.en=1

on opt6.down:
  press_y.val=tch1

on opt6.up:
  tap_slot.val=6
  tap_eval.en=1

on opt7.down:
  press_y.val=tch1

on opt7.up:
  tap_slot.val=7
  tap_eval.en=1

on render.timer:
  // render timer event
  render.en=0
  for(sys0=0;sys0<opt_count.val;sys0++)
  {
    sys1=sys0+6
    sys2=selection_mask.val>>sys0
    b[sys1].val=sys2&1
  }

on init.timer:
  // init timer event
  init.en=0
  // Hide everything, so a page change repaints from a clean card
  vis 255,0
  // Card rows: all options up to 8 (keeps full height on a partial last page)
  sys2=total_count.val
  if(sys2>8)
  {
    sys2=8
  }
  if(display_mode==2)
  {
    // Portrait (card 280 wide, starts at 20,40)
    sys0=sys2*39
    sys0+=41
    if(total_count.val>8)
    {
      sys0+=40  // footer row
    }
    fill 20,40,280,sys0,21197
    sys1=sys0-8
    fill 24,44,272,sys1,61310
  }else
  {
    // Landscape (card 350 wide, starts at 50,20)
    sys0=sys2*28
    sys0+=38
    if(total_count.val>8)
    {
      sys0+=30  // footer row
    }
    fill 50,20,350,sys0,21197
    sys1=sys0-8
    fill 54,24,342,sys1,61310
  }
  // Card height, used by the page Touch Release to close only on taps outside the card
  card_h.val=sys0
  // Show static header components
  vis header_bg,1
  vis btn_back,1
  vis lbl_title,1
  // Show footer (page navigation) only when paged
  if(total_count.val>8)
  {
    vis btn_prev,1
    vis lbl_hint,1
    vis btn_next,1
    vis hs_prev,1
    vis hs_next,1
  }
  // Show populated opt buttons
  sys1=opt_count.val+6
  for(sys0=6;sys0<sys1;sys0++)
  {
    vis b[sys0],1
  }
  // Kick render to paint selection state
  render.en=1

on tap_eval.timer:
  // tap_eval timer event: tells a swipe from a tap on an option button
  tap_eval.en=0
  sys0=press_y.val-tch3  // positive: finger moved up
  sys1=tch3-press_y.val  // positive: finger moved down
  if(sys0>=40)
  {
    // Swipe up: next page, reported as a hs_next (28) release
    printh 65
    prints dp,1
    printh 1C 00 FF FF FF
    render.en=1
  }else if(sys1>=40)
  {
    // Swipe down: previous page, reported as a hs_prev (27) release
    printh 65
    prints dp,1
    printh 1B 00 FF FF FF
    render.en=1
  }else
  {
    // Tap: local feedback, then report the option button release
    sys0=tap_slot.val
    sys1=sys0+6  // component id
    if(select_mode.val==0)
    {
      if(b[sys1].val==1)
      {
        selection_mask.val=1<<sys0
      }else
      {
        selection_mask.val=0
      }
    }
    render.en=1
    printh 65
    prints dp,1
    prints sys1,1
    printh 00 FF FF FF
  }
